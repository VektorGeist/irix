# Irix configuration — copy to .env and fill in. .env is gitignored.

# Where galleries (zip storage containers) live. Default: ./galleries next to the cwd.
IRIX_GALLERY_DIR=

# Optional: tesseract binary path if not on PATH (OCR for UI parse + injection screen).
# Irix degrades gracefully without it — face-rec and tracking do not need OCR.
IRIX_TESSERACT=

# Recognition threshold (lower = stricter match). Deterministic, no model.
IRIX_FACE_MATCH_DIST=0.42
